# ==============================================================================
# Simulated E-Commerce & Kafka Event Stream Configuration
# ==============================================================================

# Kafka Operation Mode: MOCK | SASL_SSL | SSL | PLAINTEXT
# In MOCK mode, events are captured locally in-memory without needing an active Kafka cluster.
KAFKA_MODE=MOCK

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# SSL / TLS Configuration
# For cloud providers using custom CAs (e.g. Aiven ca.pem), specify path to ca.pem:
KAFKA_SSL_CA_LOCATION=
# Set to false to bypass certificate verification during local development/testing:
KAFKA_ENABLE_SSL_VERIFICATION=false
KAFKA_SSL_CERTIFICATE_LOCATION=
KAFKA_SSL_KEY_LOCATION=
KAFKA_SSL_KEY_PASSWORD=

# Kafka Topic Mappings (Consolidated to 4 Topics Max)
TOPIC_USERS=ecom.users
TOPIC_BROWSE=ecom.browse
TOPIC_CART=ecom.cart
TOPIC_ORDERS=ecom.orders

# Application & Simulator Settings
APP_VERSION=2.4.1
SECRET_KEY=simulated-ecom-secret-key-39281
FLASK_PORT=5000
FLASK_DEBUG=false
SIMULATOR_NUM_USERS=5
SIMULATOR_TICK_SECONDS=1.5
